# ─────────────────────────────────────────────────────────────────────────────
# VPS Security Dashboard — Environment Variables Reference
#
# These variables are set in Coolify's UI under:
#   Your Application → Environment Variables
#
# DO NOT create a .env file for production — Coolify injects these at runtime.
# For local development only: cp env.example .env.local
#
# The dashboard uses self-contained username/password authentication.
# No external OAuth provider or third-party platform is required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Session Security (REQUIRED) ───────────────────────────────────────────────
# Secret used to sign JWT session tokens. Must be cryptographically random.
# Generate with: openssl rand -hex 32
# Changing this value invalidates all existing sessions (all users are logged out).
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Path to the SQLite database file inside the container.
# In Coolify, add a persistent volume mapping:
#   Source (host path): /data/vps-security-dashboard   (or any host path)
#   Destination (container path): /app/data
# This ensures the database survives container restarts and redeploys.
SQLITE_DB_PATH=/app/data/security-dashboard.db

# ── Node Environment (REQUIRED) ───────────────────────────────────────────────
NODE_ENV=production

# ── Port (OPTIONAL) ───────────────────────────────────────────────────────────
# The port the Node.js server listens on inside the container.
# Coolify's proxy routes external traffic to this port automatically.
# Default is 3000 — only change if you have a specific reason to.
# PORT=3000
