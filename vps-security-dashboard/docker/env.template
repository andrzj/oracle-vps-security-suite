# ─────────────────────────────────────────────────────────────────────────────
# VPS Security Dashboard — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL/TiDB connection string (provided by Manus platform)
DATABASE_URL=mysql://user:password@host:3306/dbname

# ── Authentication ────────────────────────────────────────────────────────────
# JWT secret for session signing — generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# Manus OAuth credentials (from Manus project settings)
VITE_APP_ID=REPLACE_WITH_APP_ID
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# ── Owner Identity ────────────────────────────────────────────────────────────
OWNER_OPEN_ID=REPLACE_WITH_YOUR_OPEN_ID
OWNER_NAME=REPLACE_WITH_YOUR_NAME

# ── Manus Built-in APIs ───────────────────────────────────────────────────────
BUILT_IN_FORGE_API_KEY=REPLACE_WITH_API_KEY
BUILT_IN_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=REPLACE_WITH_FRONTEND_KEY
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# ── Analytics (optional) ──────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
