# ─────────────────────────────────────────────────────────────────────────────
# VPS Security Dashboard — Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp env.template .env && chmod 600 .env
#
# NEVER commit .env to version control.
# The dashboard uses self-contained username/password authentication.
# No external OAuth provider or third-party platform is required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & TLS ──────────────────────────────────────────────────────────────
# Your domain name. Caddy will automatically obtain a Let's Encrypt certificate.
# The domain must already point to this server's IP via DNS before starting.
# Example: security.yourdomain.com
DOMAIN=security.yourdomain.com

# ── Access Control (CRITICAL) ─────────────────────────────────────────────────
# Your home/office IP address. Caddy blocks ALL other IPs from accessing the
# dashboard. This is the single most effective security measure in the stack.
# The login page and every API endpoint are invisible to the rest of the internet.
#
# To find your current IP:  curl https://ifconfig.me
# For dynamic IPs:          use a VPN with a static exit IP and set that IP here
# For CIDR ranges:          use e.g. 203.0.113.0/24 to allow a /24 subnet
TRUSTED_IP=YOUR_HOME_IP_HERE

# ── Session Security ──────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Must be cryptographically random.
# Generate with: openssl rand -hex 32
# Changing this value will invalidate all existing sessions.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path inside the container.
# The /app/data directory is mounted as a named Docker volume for persistence.
# No separate database service is needed — SQLite runs inside the app container.
#
# Backup command (run on host):
#   docker run --rm -v vps-security-dashboard_app_data:/data alpine \
#     tar czf - /data > security-dashboard-backup-$(date +%Y%m%d).tar.gz
SQLITE_DB_PATH=/app/data/security-dashboard.db

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production
